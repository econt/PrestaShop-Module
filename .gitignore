# Only the listed paths are in the repo. Git does not look into an ignored directory,
# so a directory is let in first and then what is in it.
/*
!/.gitignore
!/README.md
!/codecompletion/
!/econt_delivery_zip_generator.php
!/EcontDelivery-PrestaShop-Module.zip
!/modules/
/modules/*
!/modules/econtdelivery/
!/modules/econtdeliverypayment/
.DS_Store
